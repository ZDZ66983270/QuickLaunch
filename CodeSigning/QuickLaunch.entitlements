<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox (required for App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- File system access -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Read access to Applications directories -->
    <key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
    <array>
        <string>/Applications</string>
        <string>/System/Applications</string>
        <string>/System/Applications/Utilities</string>
    </array>

    <!-- User's Applications folder -->
    <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
    <array>
        <string>Applications</string>
    </array>

    <!-- Network access (disabled - app doesn't need internet) -->
    <key>com.apple.security.network.client</key>
    <false/>
    <key>com.apple.security.network.server</key>
    <false/>

    <!-- Hardware access (disabled) -->
    <key>com.apple.security.device.audio-input</key>
    <false/>
    <key>com.apple.security.device.camera</key>
    <false/>

    <!-- Print/Files access (disabled) -->
    <key>com.apple.security.print</key>
    <false/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <false/>

    <!-- Hardened Runtime settings -->
    <key>com.apple.security.cs.allow-jit</key>
    <false/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <false/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <false/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <false/>

    <!-- Automation (for launching apps) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>